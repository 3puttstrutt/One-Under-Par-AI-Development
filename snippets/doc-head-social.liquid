{%- liquid
  assign og_title = page_title | default: 'One Under Par'
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | strip_html | strip

  if request.page_type == 'index'
    assign og_title = 'Premium Golf Hats with Purpose | One Under Par'
    assign og_description = 'Shop premium vintage-inspired golf hats for men and women. Every item purchased generates a $5 philanthropic contribution.'
  elsif request.page_type == 'product'
    assign og_type = 'product'
    if og_description == blank
      assign og_description = product.description | strip_html | strip_newlines | replace: '  ', ' ' | truncate: 155
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    if og_description == blank
      assign og_description = article.excerpt_or_content | strip_html | strip_newlines | replace: '  ', ' ' | truncate: 155
    endif
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
    if og_description == blank
      assign og_description = collection.description | strip_html | strip_newlines | replace: '  ', ' ' | truncate: 155
    endif
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif

  if og_description == blank
    assign og_description = 'One Under Par creates premium vintage-inspired golf hats with purpose. Every item purchased generates a $5 philanthropic contribution.'
  endif

  assign og_locale = request.locale.iso_code | replace: '-', '_'
-%}

<meta property="og:site_name" content="One Under Par">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

{%- unless settings.social_twitter_url == blank -%}
  {%- liquid
    assign split_twitter_url = settings.social_twitter_url | split: '/'
    for part in split_twitter_url reversed
      if part != blank
        assign twitter_handle = part
        break
      endif
    endfor
  -%}
  <meta name="twitter:site" content="@{{ twitter_handle }}">
{%- endunless -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if page_image -%}<meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif -%}
