{%- unless request.page_type == 'index' or request.page_type == 'password' -%}
  {%- liquid
    assign breadcrumb_name = page_title
    assign breadcrumb_url = canonical_url
    assign parent_name = blank
    assign parent_url = blank

    if request.page_type == 'product'
      assign breadcrumb_name = product.title
      if collection
        assign parent_name = collection.title
        assign parent_url = shop.url | append: collection.url
      else
        assign parent_name = 'Golf Hats'
        assign parent_url = shop.url | append: routes.all_products_collection_url
      endif
    elsif request.page_type == 'collection'
      assign breadcrumb_name = collection.title
      assign parent_name = 'Shop'
      assign parent_url = shop.url | append: routes.all_products_collection_url
    elsif request.page_type == 'article'
      assign breadcrumb_name = article.title
      assign parent_name = blog.title
      assign parent_url = shop.url | append: blog.url
    endif
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      }
      {%- if parent_name != blank -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ parent_name | json }},
        "item": {{ parent_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ breadcrumb_name | json }},
        "item": {{ breadcrumb_url | json }}
      }
      {%- else -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ breadcrumb_name | json }},
        "item": {{ breadcrumb_url | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endunless -%}
